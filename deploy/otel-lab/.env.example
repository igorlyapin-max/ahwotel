# Explicit host LAN IPv4 address; use 127.0.0.1 only for a host-only lab.
LAB_BIND_ADDRESS=192.168.1.10
LAB_PROJECT_NAME=ahwotel-lab
OTLP_PORT=4318
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
COLLECTOR_HEALTH_PORT=13133
RETENTION_DAYS=14
RETENTION_SIZE=2GB
PROMETHEUS_MEMORY_LIMIT=2g
GRAFANA_MEMORY_LIMIT=1g
OUT_OF_ORDER_WINDOW=24h
# Explicit exception only for snap Docker hosts where no-new-privileges prevents exec.
LAB_SNAP_DOCKER=0
